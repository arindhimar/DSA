CREATE TABLE MarkTable (
    Student_RollNumber NUMBER,
    Sub1 NUMBER,
    Sub2 NUMBER,
    Sub3 NUMBER,
    Percentage NUMBER(5, 2),
    Grade varchar(30) 
);

create or replace trigger automarks  
before insert or update on MarkTable
for each row
begin
:new.Percentage:=new.Sub1+:new.Sub2+:new.Sub3;
if :new.Percentage>=70 then
	:new.Grade='Distinction';
elsif :new.Grade>=50 then
	:new.Grade='First';
elsif :new.Grade>=40 then
	:new.Grade='Second';
else 
	:new.Grade='Fail';
end if;
end

BEGIN
