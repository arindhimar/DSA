    Address VARCHAR2(255),
    Telephone VARCHAR2(20),
    Mobile VARCHAR2(20)
);


CREATE TABLE SalesInformation11 (
    DealerCode NUMBER,
    Year NUMBER,
    SalesAmount NUMBER
);


CREATE TABLE CityMaster11 (
    CityCode NUMBER PRIMARY KEY,
    CityName VARCHAR2(255)
);

BEGIN

