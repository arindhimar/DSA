VALUES (1, 2010, 50000);

END

CREATE OR REPLACE PROCEDURE q11a(
    pCityName IN VARCHAR2,
    pYear IN NUMBER,
    pSalesTotal OUT NUMBER
) AS
BEGIN
    SELECT SUM(si.SalesAmount)
    INTO pSalesTotal
    FROM SalesInformation11 si
    JOIN DealerMaster11 dm ON si.DealerCode = dm.DealerCode
    JOIN CityMaster11 cm ON dm.CityCode = cm.CityCode
    WHERE cm.CityName = pCityName AND si.Year = pYear;
END q11a;

DECLARE
    vSalesTotal NUMBER;
BEGIN
    q11a('Surat', 2010, vSalesTotal);
    DBMS_OUTPUT.PUT_LINE('Total Sales in Surat in 2010: ' || vSalesTotal);
END;

CREATE OR REPLACE PROCEDURE GetDealersByCityAndYear (
    pCityName IN VARCHAR2,
    pYear IN NUMBER,
    temp_name OUT VARCHAR2
) AS
BEGIN
    SELECT DealerName INTO temp_name
    FROM DealerMaster11
    WHERE DealerCode IN (
        SELECT DealerCode
        FROM SalesInformation11
        WHERE SalesAmount = (SELECT MAX(SalesAmount) FROM SalesInformation11 WHERE Year = pYear)
        AND Year = pYear
    )
    AND CityCode = (SELECT CityCode FROM CityMaster11 WHERE CityName = pCityName);
END GetDealersByCityAndYear;


DECLARE
    vCityName VARCHAR2(255) := 'Surat'; 
    vYear NUMBER := 2010; 
    vDealerName VARCHAR2(255);
BEGIN
    GetDealersByCityAndYear(vCityName, vYear, vDealerName);
   
    DBMS_OUTPUT.PUT_LINE('Top Dealer in ' || vCityName || ' for Year ' || vYear || ': ' || vDealerName);
END;
