    NetPayment NUMBER(10, 2)   -- Assuming you want a decimal number with 2 decimal places for NetPayment
);

create or replace trigger calamount
before insert or update on Bill
for each row
begin
 if :new.BillAmount > 10000 then
	:new.Discount:=20;
elsif :new.BillAmount > 1000 then
	:new.Discount:=10;
else
	:new.Discount:=5; 
end if;
	:new.NetPayment:=:new.BillAmount+(:new.BillAmount+:new.BillAmount*:new.Discount/100);
end

