CREATE OR REPLACE PROCEDURE a2q2(
    tempid IN NUMBER,
    temp OUT number
) AS
BEGIN
    SELECT count(*) into temp
    FROM STUDENTRESULTS
    WHERE COURSEID= tempid ;

END a2q2;
/





DECLARE
    vCourseId NUMBER := 101; 
    vTotalStudents NUMBER;
BEGIN
    a2q2(vCourseId, vTotalStudents);
    DBMS_OUTPUT.PUT_LINE('Total students for CourseID ' || vCourseId || ': ' || vTotalStudents);
END;
/

