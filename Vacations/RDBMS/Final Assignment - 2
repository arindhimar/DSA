CREATE OR REPLACE PROCEDURE GetTotalStudentsByCourseName (
    pCourseName IN VARCHAR2,
    pTotalStudents OUT NUMBER
) AS
BEGIN
SELECT COUNT(*) INTO pTotalStudents 
FROM STUDENTRESULTS
WHERE COURSEID IN (
    SELECT COURSEID
    FROM COURSE
    WHERE COURSENAME = pCourseName 
);
END GetTotalStudentsByCourseName;
/


DECLARE
    vCourseName VARCHAR2(255) := 'Math'; 
    vTotalStudents NUMBER;
BEGIN
    GetTotalStudentsByCourseName(vCourseName, vTotalStudents);

    -- Display the total number of students for the course
    DBMS_OUTPUT.PUT_LINE('Total students for Course Name ' || vCourseName || ': ' || vTotalStudents);
END;
/


