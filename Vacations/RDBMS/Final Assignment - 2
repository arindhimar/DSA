

CREATE TABLE STUDENTRESULTS (
    STUDENTID NUMBER,
    SEMESTER NUMBER,
    SUB1 NUMBER,
    SUB2 NUMBER,
    SUB3 NUMBER,
    SUB4 NUMBER,
    SUB5 NUMBER,
    PERCENTAGE NUMBER,
    GRADE VARCHAR(30),
    COURSEID NUMBER
);

CREATE TABLE COURSE(
COURSEID NUMBER PRIMARY KEY,
COURSENAME VARCHAR(255)
)

=q1=

CREATE OR REPLACE PROCEDURE GetStudentInfoById (
    pStudentId IN NUMBER,
    pStudentInfo OUT STUDENTRESULTS%ROWTYPE
) AS
BEGIN
    SELECT *
    INTO pStudentInfo
    FROM STUDENTRESULTS
    WHERE STUDENTID = pStudentId;
EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE('Student with ID ' || pStudentId || ' not found.');
END GetStudentInfoById;
/

DECLARE
    vStudentId NUMBER := 1;
    vStudentInfo STUDENTRESULTS%ROWTYPE;
BEGIN
    GetStudentInfoById(vStudentId, vStudentInfo);
    
    IF vStudentInfo.STUDENTID IS NOT NULL THEN
        DBMS_OUTPUT.PUT_LINE('StudentID: ' || vStudentInfo.STUDENTID);
        DBMS_OUTPUT.PUT_LINE('Semester: ' || vStudentInfo.SEMESTER);
    END IF;
END;
/


